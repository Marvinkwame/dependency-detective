{
  "name": "dependency-detective",
  "version": "0.4.1",
  "description": "Finds unused dependencies, known vulnerabilities (via OSV.dev), and deprecated packages in your Node.js project",
  "main": "index.js",
  "type": "module",
  "bin": {
    "dependency-detective": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test"
  },
  "keywords": [
    "dependencies",
    "npm",
    "node",
    "security",
    "optimization"
  ],
  "author": "Marvin Ackerman",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "axios": "^1.21.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "glob": "^14.0.6",
    "ora": "^8.2.0",
    "semver": "^7.8.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marvinkwame/dependency-detective.git"
  },
  "homepage": "https://github.com/Marvinkwame/dependency-detective#",
  "files": [
    "index.js",
    "src/"
  ],
  "engines": {
    "node": ">=18"
  }
}
